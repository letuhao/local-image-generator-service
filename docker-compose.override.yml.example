# Dev overrides — copy to `docker-compose.override.yml` and customise.
# This file is loaded automatically by `docker compose up` when it exists.
# It MUST stay out of production — the base `docker-compose.yml` keeps
# ComfyUI and MinIO on the private `internal` network only.

services:
  image-gen-service:
    ports:
      - "127.0.0.1:8700:8000"     # local-only: curl http://127.0.0.1:8700/health
    # Optional dev ergonomics: run Python from the host so `app/` edits apply
    # without `docker compose build`. Base compose does NOT mount `./app/`.
    # volumes:
    #   - ./app:/app/app:ro

  comfyui:
    ports:
      - "127.0.0.1:8188:8188"     # local-only: ComfyUI web UI for debugging

  # `comfyui-sage` publishes 127.0.0.1:8190→8188 by default in docker-compose.yml.
  # Override bind/port here only if you need something different from COMFY_SAGE_* in `.env`.

  minio:
    ports:
      # Host ports are configurable via .env (defaults avoid clashing with other
      # MinIO stacks on 9000/9001). Container-internal ports stay 9000/9001 so
      # S3_INTERNAL_ENDPOINT=http://minio:9000 inside the network is unchanged.
      - "${MINIO_BIND:-127.0.0.1}:${MINIO_HOST_PORT:-9100}:9000" # S3 API
      - "${MINIO_BIND:-127.0.0.1}:${MINIO_CONSOLE_HOST_PORT:-9101}:9001" # Web console
